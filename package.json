{
  "name": "@parryhotter/adobe-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.gauravvvvvvvvvv/adobe-mcp",
  "description": "Local-first MCP server for controlling Adobe creative applications through compact, state-aware host adapters.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "adobe-mcp": "dist/index.js",
    "adobe-mcp-setup": "dist/setup-client.js"
  },
  "files": [
    "dist",
    "adapters",
    "docs",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "doctor": "tsx src/doctor.ts",
    "install:windows": "powershell -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "uninstall:windows": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-windows.ps1",
    "check": "npm run typecheck && npm test && npm run build",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "install:macos": "bash scripts/install-macos.sh",
    "uninstall:macos": "bash scripts/uninstall-macos.sh",
    "photoshop:dev:windows": "powershell -ExecutionPolicy Bypass -File scripts/enable-photoshop-dev-windows.ps1",
    "photoshop:dev:macos": "bash scripts/enable-photoshop-dev-macos.sh",
    "setup:codex": "tsx src/setup-client.ts --client codex",
    "setup:claude": "tsx src/setup-client.ts --client claude",
    "prepack": "npm run check"
  },
  "keywords": [
    "mcp",
    "adobe",
    "premiere-pro",
    "after-effects",
    "photoshop",
    "illustrator",
    "creative-automation"
  ],
  "license": "MIT",
  "author": "Gaurav",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gauravvvvvvvvvv/adobe-mcp.git"
  },
  "homepage": "https://github.com/gauravvvvvvvvvv/adobe-mcp#readme",
  "bugs": {
    "url": "https://github.com/gauravvvvvvvvvv/adobe-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
