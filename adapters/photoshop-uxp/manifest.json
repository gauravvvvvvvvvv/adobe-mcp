{
  "id": "com.gaurav.adobe-mcp.photoshop",
  "name": "Adobe MCP Bridge",
  "version": "0.1.0",
  "manifestVersion": 5,
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": [
        "ws://127.0.0.1:38470",
        "ws://localhost:38470"
      ]
    },
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "adobeMcpBridge",
      "label": {
        "default": "Adobe MCP"
      },
      "minimumSize": {
        "width": 220,
        "height": 90
      },
      "preferredDockedSize": {
        "width": 280,
        "height": 120
      }
    }
  ]
}
